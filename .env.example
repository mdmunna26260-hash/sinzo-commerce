# ==== DATABASE ====
# Dev (SQLite): file:./dev.db  |  Production (PostgreSQL): postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"

# ==== DEPLOYMENT CHANNEL (order isolation) ====
# vps = primary storefront (default) | vercel = Vercel deployment
# VPS docker-compose sets this automatically; Vercel env e DEPLOY_CHANNEL=vercel din
DEPLOY_CHANNEL="vps"

# ==== SECURITY ====
SESSION_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ==== META PIXEL / CAPI (set from Admin > Settings > Tracking, or here as fallback) ====
META_PIXEL_ID=""
META_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# ==== GOOGLE ====
GA4_MEASUREMENT_ID=""
GTM_ID=""

# ==== STEADFAST COURIER (set from Admin > Settings > Courier) ====
STEADFAST_API_URL="https://portal.packzy.com/api/v1"
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# ==== WHATSAPP LINKED-DEVICE BRIDGE (internal service, npm run wa) ====
WA_BRIDGE_KEY="change-this-bridge-key"
WA_BRIDGE_PORT=3001
