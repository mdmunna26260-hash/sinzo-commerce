# ==== DATABASE ====
# Dev (SQLite): file:./dev.db  |  Production (PostgreSQL): postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"
#   Self-hosted on the VPS instead of Neon (recommended: it is one hop inside the compose network):
#     DATABASE_URL="postgresql://sinzo:<POSTGRES_PASSWORD>@db:5432/sinzo_live"
#   Migrate + verify + rollback: deploy/NEON-TO-VPS.md   (tool: deploy/neon-to-vps.sh)
#   Integrity check after any copy: npm run db:verify -- (SRC_URL=… DST_URL=…)

# ==== DEPLOYMENT CHANNEL (order isolation) ====
# vps = primary storefront (default) | vercel = Vercel deployment
# VPS docker-compose sets this automatically; Vercel env e DEPLOY_CHANNEL=vercel din
DEPLOY_CHANNEL="vps"

# ==== SECURITY ====
SESSION_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ==== META PIXEL / CAPI (set from Admin > Settings > Tracking, or here as fallback) ====
META_PIXEL_ID=""
META_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# ==== GOOGLE ====
GA4_MEASUREMENT_ID=""
GTM_ID=""

# ==== STEADFAST COURIER (set from Admin > Settings > Courier) ====
STEADFAST_API_URL="https://portal.packzy.com/api/v1"
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# ==== WHATSAPP LINKED-DEVICE BRIDGE (internal service, npm run wa) ====
WA_BRIDGE_KEY="change-this-bridge-key"
WA_BRIDGE_PORT=3001

# ==== SECURITY / HEADINGS (added after the 2026-09-15 audit) ====
# REQUIRED in production. If it is missing the app refuses the built-in default and
# generates a random secret per boot (every restart logs everyone out) — set this in
# Dokploy → Environment so sessions survive a deploy.
SESSION_SECRET=""
# 1 = also accept the admin token from ?t= / Bearer (preview & debugging only).
# Off in production by default: tokens in URLs end up in history, logs and Referer.
AUTH_URL_TOKEN=""
# 1 = enforce the Content-Security-Policy instead of Report-Only. Watch Admin →
# Tracking for a few days first, otherwise a missed origin can break the pixel/GTM.
CSP_ENFORCE=""
