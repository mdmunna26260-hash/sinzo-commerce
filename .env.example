# ==== DATABASE ====
# Dev (SQLite): file:./dev.db  |  Production (PostgreSQL): postgresql://user:pass@host:5432/db
DATABASE_URL="file:./dev.db"
#   Self-hosted on the VPS instead of Neon (recommended: it is one hop inside the compose network):
#     DATABASE_URL="postgresql://sinzo:<POSTGRES_PASSWORD>@db:5432/sinzo_live"
#   Migrate + verify + rollback: deploy/NEON-TO-VPS.md   (tool: deploy/neon-to-vps.sh)
#   Integrity check after any copy: npm run db:verify -- (SRC_URL=… DST_URL=…)

# ==== DEPLOYMENT CHANNEL (order isolation) ====
# vps = primary storefront (default) | vercel = Vercel deployment
# VPS docker-compose sets this automatically; Vercel env e DEPLOY_CHANNEL=vercel din
DEPLOY_CHANNEL="vps"

# ==== SECURITY ====
SESSION_SECRET="generate-a-long-random-string"
NEXT_PUBLIC_SITE_URL="https://yourdomain.com"

# ==== META PIXEL / CAPI (set from Admin > Settings > Tracking, or here as fallback) ====
META_PIXEL_ID=""
META_ACCESS_TOKEN=""
META_TEST_EVENT_CODE=""

# ==== GOOGLE ====
GA4_MEASUREMENT_ID=""
GTM_ID=""

# ==== STEADFAST COURIER (set from Admin > Settings > Courier) ====
STEADFAST_API_URL="https://portal.packzy.com/api/v1"
STEADFAST_API_KEY=""
STEADFAST_SECRET_KEY=""

# ==== WHATSAPP LINKED-DEVICE BRIDGE (internal service, npm run wa) ====
# REQUIRED in production. /api/wa/inbound, /api/wa/device, /api/wa/receipt and /api/wa/tick
# are reachable from the internet, and they used to accept the hardcoded default
# "local-bridge" whenever this was unset — which let an anonymous caller forge inbox
# messages, opt arbitrary numbers out of marketing, mark a device BANNED, or drain the
# outbound broadcast queue. Production now REFUSES the default and any key shorter than
# 16 characters, so the webhooks simply 401 until a real key is set.
#   Generate: openssl rand -hex 32
WA_BRIDGE_KEY=""
WA_BRIDGE_PORT=3001
# Key scripts/wa-worker.js uses for /api/wa/tick. Defaults to WA_BRIDGE_KEY when unset,
# and the same production rule applies.
WA_WORKER_KEY=""

# ==== SECURITY / HEADINGS (added after the 2026-09-15 audit) ====
# REQUIRED in production. If it is missing the app refuses the built-in default and
# generates a random secret per boot (every restart logs everyone out) — set this in
# Dokploy → Environment so sessions survive a deploy.
SESSION_SECRET=""
# 1 = also accept the admin token from ?t= / Bearer (preview & debugging only).
# Off in production by default: tokens in URLs end up in history, logs and Referer.
AUTH_URL_TOKEN=""
# 1 = enforce the Content-Security-Policy instead of Report-Only. Watch Admin →
# Tracking for a few days first, otherwise a missed origin can break the pixel/GTM.
CSP_ENFORCE=""

# ==== CLIENT IP / RATE LIMITING ====
# Every rate limit and the fraud auto-blacklist are keyed on the client IP. XFF is a chain
# that each proxy APPENDS to, so the client is counted from the RIGHT, not the left — the
# left-most value is whatever the caller chose to send. Set this to the number of proxies
# YOU operate in front of the app:
#   1 = Traefik/Dokploy only (the default, correct for the compose stack in this repo)
#   2 = Cloudflare (or another CDN) in front of Traefik
# Getting it wrong is fail-safe: it resolves to a non-blockable placeholder rather than to
# an attacker-chosen address, and lib/risk.ts never auto-blacklists a placeholder.
TRUSTED_PROXY_HOPS="1"
# Set to 1 only when Cloudflare terminates TLS for this app; CF-Connecting-IP is then used
# directly. Leave unset behind any other proxy — it is a client-visible header otherwise.
TRUST_CLOUDFLARE=""

# ==== REDIRECT ALLOW-LIST ====
# /l/<slug> 302s to WaLink.target. Same-origin targets are always allowed; off-site
# targets must be http(s) AND on this list (wa.me / api.whatsapp.com / chat.whatsapp.com
# are allowed by default). Comma-separated hosts or URLs, subdomains included:
#   REDIRECT_ALLOWLIST="facebook.com,instagram.com,https://youtu.be"
REDIRECT_ALLOWLIST=""

# Abandoned checkout scheduler (server-only; leave automation disabled until tested).
# Generate independently: openssl rand -hex 32. Never put this key in a URL.
CRON_SECRET=""
# Internal URL for the server-side worker, NOT a browser-facing service URL.
RECOVERY_API_URL="http://127.0.0.1:3000/api/admin/abandoned-recover"
