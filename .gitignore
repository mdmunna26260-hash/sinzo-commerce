# dependencies
node_modules/

# next.js build
.next/
out/
next-env.d.ts

# environment (SECRETS!) — .env.example is committed
.env
.env*.local

# database (seed re-creates it: npm run db:push && npm run db:seed)
prisma/dev.db
prisma/dev.db-journal
prisma/*.db-wal
prisma/*.db-shm
*.db

# whatsapp linked-device session (sensitive — never commit)
wa-session/

# user-uploaded media (keep seed images)
public/uploads/*
!public/uploads/seed/

# misc
*.log
.DS_Store
*.tsbuildinfo
backup/
